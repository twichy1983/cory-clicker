{
  "name": "clickonomics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Clickonomics: a satirical idle clicker game in plain HTML, CSS and JavaScript.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "test": "node --test --test-reporter=spec \"tests/unit/**/*.test.js\"",
    "test:e2e": "node --test --test-reporter=spec --test-concurrency=1 \"tests/e2e/**/*.e2e.js\"",
    "test:e2e:headed": "node --test --test-reporter=spec --test-concurrency=1 \"tests/e2e/**/*.e2e.js\"",
    "screenshots": "node scripts/screenshots.js",
    "build": "node scripts/build.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "node scripts/dev.js --dist"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.10.1"
  }
}
